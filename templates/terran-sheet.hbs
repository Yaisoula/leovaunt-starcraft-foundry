<section class="hud-shell">
<header class="hud-header"><span>RAIDERS // PERSONNEL FILE</span><strong>TERRAN INTERFACE v0.1</strong></header>
<div class="hud-identity"><img src="{{actor.img}}" alt="Portrait"/><div><label>Operative <strong>{{actor.name}}</strong></label><label>Player <input name="system.player" value="{{s.player}}"/></label><label>Background <input name="system.background" value="{{s.background}}"/></label></div><div><label>Level <input type="number" name="system.level" value="{{s.level}}"/></label><label>Faction <input name="system.faction" value="{{s.faction}}"/></label><label>Quirk <input name="system.quirk" value="{{s.quirk}}"/></label></div></div>
<div class="hud-resources"><div>HP <input type="number" name="system.resources.hp.value" value="{{s.resources.hp.value}}"/> / {{derived.computed.hpMax}}</div><div>Shields <input type="number" name="system.resources.shields.value" value="{{s.resources.shields.value}}"/> / <input type="number" name="system.resources.shields.max" value="{{s.resources.shields.max}}"/></div><div>Fatigue <input type="number" name="system.resources.fatigue.value" value="{{s.resources.fatigue.value}}"/> / <input type="number" name="system.resources.fatigue.max" value="{{s.resources.fatigue.max}}"/></div></div>
<div class="hud-columns">
<section class="hud-panel"><h3>ATTRIBUTES</h3>{{#each attributes}}<div class="hud-stat"><button type="button" data-action="rollAttribute" data-attribute="{{key}}">◈</button><span>{{name}}</span><input type="number" name="system.attributes.{{key}}.base" value="{{base}}"/><input type="number" name="system.attributes.{{key}}.misc" value="{{misc}}"/><b>{{total}}</b></div>{{/each}}<h3>PROWESS</h3>{{#each prowess}}<div class="hud-stat"><span>{{name}}</span><input type="number" name="system.prowess.{{key}}.ranks" value="{{ranks}}"/></div>{{/each}}</section>
<section class="hud-panel"><h3>COMBAT TELEMETRY</h3><div class="hud-values"><div>Defense <b>{{derived.computed.defense}}</b></div><div>Toughness <b>{{derived.computed.toughness}}</b></div><div>Resolve <b>{{derived.computed.resolve}}</b></div><div>Damage Threshold <b>{{derived.computed.damageThreshold}}</b></div><div>Damage Resistance <b>{{derived.computed.damageResistance}}</b></div><div>Psionic Resistance <b>{{derived.computed.psionicResistance}}</b></div><div>Healing Threshold <b>{{derived.computed.healingThreshold}}</b></div><div>Move <b>{{derived.computed.moveSpeed}}</b></div><div>Shift <b>{{derived.computed.shiftSpeed}}</b></div><div>Initiative <b>{{derived.computed.initiative}}</b></div><div>Morale <b>{{derived.computed.moraleBonus}}</b></div></div><h3>ARMOR / MODIFIERS</h3><div class="hud-mods"><label>Armor DR <input type="number" name="system.combat.armorResistance" value="{{s.combat.armorResistance}}"/></label><label>Armor Defense <input type="number" name="system.combat.armorDefensePenalty" value="{{s.combat.armorDefensePenalty}}"/></label><label>Psi Level <input type="number" name="system.combat.psiLevel" value="{{s.combat.psiLevel}}"/></label><label>Bonus HP <input type="number" name="system.combat.bonusHP" value="{{s.combat.bonusHP}}"/></label></div></section>
<section class="hud-panel"><h3>SKILL MATRIX</h3>{{#each skills}}<div class="hud-stat"><button type="button" data-action="rollSkill" data-skill="{{key}}">◈</button><span title="{{attribute}}">{{name}}</span><input type="number" name="system.skills.{{key}}.ranks" value="{{ranks}}"/><input type="number" name="system.skills.{{key}}.misc" value="{{misc}}"/><b>{{total}}</b></div>{{/each}}</section></div>
<footer class="hud-footer">EARLY ALPHA — Character and skill prototype; no combat automation yet.</footer>
</section>