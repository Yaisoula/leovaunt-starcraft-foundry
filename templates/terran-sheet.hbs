<header class="hud-header"><span>RAIDERS // PERSONNEL FILE</span><strong>TERRAN INTERFACE • ALPHA</strong></header>
<div class="hud-identity hud-identity-simple hud-identity-telemetry"><img src="{{actor.img}}" alt="Portrait"/><div class="hud-identity-stats"><label>Character Name <input name="name" value="{{actor.name}}" placeholder="Enter character name"/></label><div class="hud-values"><div>Defense <b>{{derived.computed.defense}}</b></div><div>Toughness <b>{{derived.computed.toughness}}</b></div><div>Resolve <b>{{derived.computed.resolve}}</b></div><div>Damage Threshold <b>{{derived.computed.damageThreshold}}</b></div><div>Damage Resistance <b>{{derived.computed.damageResistance}}</b></div><div>Psionic Resistance <b>{{derived.computed.psionicResistance}}</b></div><div>Healing Threshold <b>{{derived.computed.healingThreshold}}</b></div><div>Move <b>{{derived.computed.moveSpeed}}</b></div><div>Shift <b>{{derived.computed.shiftSpeed}}</b></div><div>Initiative <b>{{derived.computed.initiative}}</b></div><div>Morale Bonus <b>{{derived.computed.moraleBonus}}</b></div></div></div></div>
<div class="hud-resources"><div>HP <input type="number" name="system.resources.hp.value" value="{{s.resources.hp.value}}"/> / {{derived.computed.hpMax}}</div><div>Shields <input type="number" name="system.resources.shields.value" value="{{s.resources.shields.value}}"/> / <input type="number" name="system.resources.shields.max" value="{{s.resources.shields.max}}"/></div><div>Fatigue <input type="number" name="system.resources.fatigue.value" value="{{s.resources.fatigue.value}}"/> / <input type="number" name="system.resources.fatigue.max" value="{{s.resources.fatigue.max}}"/></div><div class="hud-morale-card"><span>Current Morale</span><button type="button" data-action="adjustMorale" data-delta="-1" title="Decrease Morale">−</button><strong>{{s.resources.morale}}</strong><button type="button" data-action="adjustMorale" data-delta="1" title="Increase Morale">+</button></div></div>
<section class="hud-wounds-panel"><div class="hud-wounds-strip">
<div class="hud-wound-section"><button type="button" class="hud-wound-title" data-action="resolveWounds" title="Roll pending crippling wounds">Wounds</button><input type="number" min="0" max="100" step="1" name="system.resources.woundsPending" value="{{s.resources.woundsPending}}" title="Edit pending wounds"/></div>
{{#each woundRows}}<div class="hud-wound-section"><button type="button" class="hud-wound-title" data-action="describeWound" data-location="{{key}}" title="Show {{label}} wound effects">{{label}}</button><input type="number" min="0" max="100" value="{{points}}" data-wound-points="{{key}}"/></div>{{/each}}
<div class="hud-wound-section"><button type="button" class="hud-wound-title" data-action="describeWound" data-location="bleed" title="Show Bleed effects">Bleed</button><input type="number" min="0" max="1000" value="{{woundConditions.bleed}}" data-player-bleed/></div>
</div></section>
<nav class="hud-tabs" aria-label="Terran character sheet sections">{{#each tabs}}<button type="button" data-action="changeTab" data-tab="{{key}}" class="{{#if active}}active{{/if}}" aria-pressed="{{active}}">{{title}}</button>{{/each}}</nav>
<div class="hud-tab-content" role="region" aria-label="Character tab contents" tabindex="0">
{{#if (eq tab "combat")}}
{{/if}}
{{#if (eq tab "overview")}}
<section class="hud-panel hud-attributes-horizontal"><div class="hud-attribute-heading"><h3>ATTRIBUTES</h3><span class="hud-attribute-cap">Current Attribute Maximum - {{derived.attributeMax}}</span></div><div class="hud-attribute-strip">{{#each attributes}}<div class="hud-attribute-card"><button type="button" class="hud-attribute-name" data-action="rollAttribute" data-attribute="{{key}}">{{name}}</button><div class="hud-attribute-total {{#if over}}hud-overcap{{/if}}">{{total}}</div><div class="hud-attribute-substats"><label>Base<input type="number" name="system.attributes.{{key}}.base" value="{{base}}"/></label><label>Misc<input type="number" name="system.attributes.{{key}}.misc" value="{{misc}}"/></label></div></div>{{/each}}</div></section>

<div class="hud-columns skill-grid"><section class="hud-panel"><div class="hud-skill-heading"><h3>NON-PROWESS SKILLS</h3><span>Current Rank Maximum - {{derived.skillBaseMax}}</span></div><div class="hud-nonprowess-columns">{{#each skillColumns}}<div class="hud-nonprowess-column"><div class="hud-skill-column-labels"><span>Skill</span><span>Ranks</span><span>Focus</span><span>Misc</span><span>Total</span></div>{{#each this}}<div class="hud-stat"><button type="button" class="hud-skill-roll-name" data-action="rollSkill" data-skill="{{key}}">{{name}}</button><input class="hud-rank-input {{#if over}}hud-overcap-input{{/if}}" style="{{#if over}}color:#ff9958!important;-webkit-text-fill-color:#ff9958!important;{{/if}}" type="number" name="system.skills.{{key}}.ranks" value="{{ranks}}" min="0"/><input type="number" name="system.skills.{{key}}.focus" value="{{focus}}" min="0"/><input type="number" name="system.skills.{{key}}.misc" value="{{misc}}"/><b>{{total}}</b></div>{{/each}}</div>{{/each}}</div></section>
<section class="hud-panel"><div class="hud-skill-heading"><h3>PROWESS SKILLS</h3><span>Current Rank Maximum - {{derived.skillBaseMax}}</span></div><div class="hud-skill-column-labels hud-prowess-column-labels"><span>Skill</span><span>Ranks</span><span>Focus</span><span>Total</span></div>{{#each prowess}}<div class="hud-stat"><button type="button" class="hud-prowess-name hud-skill-roll-name" data-action="rollProwess" data-prowess="{{key}}">{{name}}</button><input class="hud-rank-input {{#if over}}hud-overcap-input{{/if}}" type="number" name="system.prowess.{{key}}.ranks" value="{{ranks}}" min="0" title="Maximum ranks: {{max}}"/><input type="number" name="system.prowess.{{key}}.focus" value="{{focus}}" min="0"/><b class="hud-prowess-total">{{total}}</b></div>{{/each}}</section></div>

{{else if (eq tab "combat")}}
<section class="hud-panel"><h3>COMBAT MODIFIERS</h3><div class="hud-mods"><label>Protection Points <input type="number" min="0" name="system.resources.protection" value="{{s.resources.protection}}"/></label></div><div class="hud-mods"><label>Armor DR <input type="number" name="system.combat.armorResistance" value="{{s.combat.armorResistance}}"/></label><label>Armor Defense <input type="number" name="system.combat.armorDefensePenalty" value="{{s.combat.armorDefensePenalty}}"/></label><label>Psi Level <input type="number" name="system.combat.psiLevel" value="{{s.combat.psiLevel}}"/></label><label>Bonus HP <input type="number" name="system.combat.bonusHP" value="{{s.combat.bonusHP}}"/></label></div><p class="hud-help">Equipped armor contributes {{derived.equipment.armorResistance}} armor DR and {{derived.equipment.armorDefensePenalty}} to Defense. Armor DR/Defense fields above are additional manual modifiers. Weapon attacks and wound automation are still planned.</p></section>
<section class="hud-panel"><h3>SPECIAL COMBAT ACTIONS</h3><div class="hud-special-actions"><button type="button" data-action="grabTarget">Grab</button><button type="button" data-action="knockDownTarget">Knock Down</button><button type="button" data-action="pushTarget">Push</button><button type="button" data-action="disarmWeapon">Disarm</button></div></section>
<section class="hud-panel"><h3>EQUIPPED WEAPONS</h3>
{{#each combatWeapons}}
<div class="hud-combat-weapon" data-item-id="{{id}}" data-base-accuracy="{{attack.accuracy}}" data-base-damage="{{attack.damage}}" data-melee="{{attack.melee}}"><div class="hud-weapon-side-actions"><button type="button" data-action="attackWeapon" data-item-id="{{id}}" title="{{#if jammed}}Weapon jammed — clear jam first{{else}}Attack with {{name}}{{/if}}" aria-label="Attack with {{name}}" {{#if jammed}}disabled{{/if}}><i class="fa-solid fa-crosshairs" aria-hidden="true"></i></button>{{#if attack.requiresAmmo}}<button type="button" data-action="reloadWeapon" data-item-id="{{id}}" title="Reload {{name}}" aria-label="Reload {{name}}"><i class="fa-solid fa-rotate-right" aria-hidden="true"></i></button>{{/if}}{{#if attack.requiresAmmo}}<button type="button" data-action="unjamWeapon" data-item-id="{{id}}" title="Clear Jam (standard action)" aria-label="Clear jam on {{name}}" {{#unless jammed}}disabled{{/unless}}><i class="fa-solid fa-screwdriver-wrench" aria-hidden="true"></i></button>{{/if}}</div><div class="hud-weapon-main"><div class="hud-weapon-heading"><strong>{{name}}</strong><span>{{range}} • {{rate}}</span></div><div class="hud-weapon-values"><span>Accuracy <b data-preview-accuracy>{{attack.accuracy}}</b></span><span>Strikes <b>{{attack.strikes}}</b></span><span>Pre-resistance Damage <b data-preview-damage>{{attack.damage}}</b></span><span>Overage Cap <b>{{attack.overageCap}}</b></span>{{#if attack.requiresAmmo}}<span>Ammo <b>{{attack.ammo}} / {{attack.capacity}}</b></span>{{/if}}</div>
<div class="hud-attack-controls"><label class="hud-firing-select">Firing Mode <select data-firing-mode>{{#each modes}}<option value="{{id}}">{{label}} ({{ammo}} ammo)</option>{{/each}}</select></label><label class="hud-attack-toggle" title="Charge: full-round action, +5 Accuracy and +10 melee damage; GM handles movement and defense restrictions."><input type="checkbox" data-charge/><span>Charge</span></label><label class="hud-attack-toggle" title="Action Move: full-round action, −2 Accuracy; GM handles movement."><input type="checkbox" data-action-move/><span>Action Move</span></label></div></div>

</div>{{else}}<p class="hud-help">Equip a weapon in Inventory to use it here.</p>{{/each}}</section>
{{else if (eq tab "inventory")}}
<section class="hud-panel hud-credits-panel"><label><strong>Credits</strong> <input type="number" min="0" step="1" name="system.resources.credits" value="{{s.resources.credits}}" aria-label="Character credits"/></label></section>
