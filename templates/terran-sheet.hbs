<section class="hud-shell">
<header class="hud-header"><span>RAIDERS // PERSONNEL FILE</span><strong>TERRAN INTERFACE • ALPHA</strong></header>
<div class="hud-identity hud-identity-simple"><img src="{{actor.img}}" alt="Portrait"/><div><label>Character Name <input name="name" value="{{actor.name}}" placeholder="Enter character name"/></label></div></div>
<div class="hud-resources"><div>HP <input type="number" name="system.resources.hp.value" value="{{s.resources.hp.value}}"/> / {{derived.computed.hpMax}}</div><div>Shields <input type="number" name="system.resources.shields.value" value="{{s.resources.shields.value}}"/> / <input type="number" name="system.resources.shields.max" value="{{s.resources.shields.max}}"/></div><div>Fatigue <input type="number" name="system.resources.fatigue.value" value="{{s.resources.fatigue.value}}"/> / <input type="number" name="system.resources.fatigue.max" value="{{s.resources.fatigue.max}}"/></div></div>
<nav class="hud-tabs" aria-label="Terran character sheet sections">{{#each tabs}}<button type="button" data-action="changeTab" data-tab="{{key}}" class="{{#if active}}active{{/if}}" aria-pressed="{{active}}">{{title}}</button>{{/each}}</nav>
<div class="hud-tab-content" role="region" aria-label="Character tab contents" tabindex="0">
{{#if (eq tab "overview")}}
<div class="hud-columns overview-grid"><section class="hud-panel"><h3>ATTRIBUTES</h3>{{#each attributes}}<div class="hud-stat"><button type="button" data-action="rollAttribute" data-attribute="{{key}}">◈</button><span>{{name}}</span><input type="number" name="system.attributes.{{key}}.base" value="{{base}}"/><input type="number" name="system.attributes.{{key}}.misc" value="{{misc}}"/><b>{{total}}</b></div>{{/each}}</section>
<section class="hud-panel"><h3>COMBAT TELEMETRY</h3><div class="hud-values"><div>Defense <b>{{derived.computed.defense}}</b></div><div>Toughness <b>{{derived.computed.toughness}}</b></div><div>Resolve <b>{{derived.computed.resolve}}</b></div><div>Damage Threshold <b>{{derived.computed.damageThreshold}}</b></div><div>Damage Resistance <b>{{derived.computed.damageResistance}}</b></div><div>Psionic Resistance <b>{{derived.computed.psionicResistance}}</b></div><div>Healing Threshold <b>{{derived.computed.healingThreshold}}</b></div><div>Move <b>{{derived.computed.moveSpeed}}</b></div><div>Shift <b>{{derived.computed.shiftSpeed}}</b></div><div>Initiative <b>{{derived.computed.initiative}}</b></div><div>Morale <b>{{derived.computed.moraleBonus}}</b></div></div><p class="hud-help">Maximum normal attribute: {{derived.attributeMax}}</p>{{#each derived.warnings}}<p class="hud-overcap">{{this}}</p>{{/each}}</section></div>
{{else if (eq tab "skills")}}
<div class="hud-columns skill-grid"><section class="hud-panel"><h3>NON-PROWESS SKILLS</h3><p class="hud-help">Roll • Skill • Ranks • Focuses • Misc • Total (cap)</p><p class="hud-help">Base rank cap: {{derived.skillBaseMax}}. First focus adds 2, each additional focus adds 1.</p>{{#each skills}}<div class="hud-stat"><button type="button" data-action="rollSkill" data-skill="{{key}}">◈</button><span title="{{attribute}}">{{name}}</span><input type="number" name="system.skills.{{key}}.ranks" value="{{ranks}}" min="0" title="Ranks (maximum {{max}})"/><input type="number" name="system.skills.{{key}}.focus" value="{{focus}}" min="0" title="Number of skill focuses"/><input type="number" name="system.skills.{{key}}.misc" value="{{misc}}"/><b title="Maximum ranks: {{max}}" class="{{#if over}}hud-overcap{{/if}}">{{total}}</b><small>/{{max}}</small></div>{{/each}}</section>
<section class="hud-panel"><h3>PROWESS SKILLS</h3>{{#each prowess}}<div class="hud-stat"><span>{{name}}</span><input type="number" name="system.prowess.{{key}}.ranks" value="{{ranks}}" min="0" title="Maximum ranks: {{max}}"/><input type="number" name="system.prowess.{{key}}.focus" value="{{focus}}" min="0" title="Number of focuses"/><small class="{{#if over}}hud-overcap{{/if}}">/{{max}}</small></div>{{/each}}</section></div>
{{else if (eq tab "combat")}}
<section class="hud-panel"><h3>COMBAT MODIFIERS</h3><div class="hud-mods"><label>Protection Points <input type="number" min="0" name="system.resources.protection" value="{{s.resources.protection}}"/></label><label>Pending Crippling Wounds <input type="number" min="0" name="system.resources.woundsPending" value="{{s.resources.woundsPending}}"/></label></div><div class="hud-mods"><label>Armor DR <input type="number" name="system.combat.armorResistance" value="{{s.combat.armorResistance}}"/></label><label>Armor Defense <input type="number" name="system.combat.armorDefensePenalty" value="{{s.combat.armorDefensePenalty}}"/></label><label>Psi Level <input type="number" name="system.combat.psiLevel" value="{{s.combat.psiLevel}}"/></label><label>Bonus HP <input type="number" name="system.combat.bonusHP" value="{{s.combat.bonusHP}}"/></label></div><p class="hud-help">Equipped armor contributes {{derived.equipment.armorResistance}} armor DR and {{derived.equipment.armorDefensePenalty}} to Defense. Armor DR/Defense fields above are additional manual modifiers. Weapon attacks and wound automation are still planned.</p></section>
<section class="hud-panel"><h3>EQUIPPED WEAPONS</h3><p class="hud-help">Standard attacks roll 1d20 + Melee/Ranged ranks + weapon accuracy + 4 for each bonus strike. Enter a target Defense to calculate hit, attack overage and pre-resistance damage automatically. Range penalties, firing traits, criticals and reload timing still require GM adjudication.</p>
{{#each combatWeapons}}
<div class="hud-combat-weapon"><strong>{{name}}</strong><span>{{range}} • {{rate}}</span><div class="hud-weapon-values"><span>Accuracy <b>{{attack.accuracy}}</b></span><span>Strikes <b>{{attack.strikes}}</b></span><span>Pre-resistance Damage <b>{{attack.damage}}</b></span><span>Overage Cap <b>{{attack.overageCap}}</b></span><span>Ammo <b>{{attack.ammo}} / {{attack.capacity}}</b></span></div>
<label class="hud-target-defense">Target Defense <input type="number" min="0" step="1" data-target-defense placeholder="Optional"/></label><div class="hud-weapon-actions"><button type="button" data-action="attackWeapon" data-item-id="{{id}}" {{#unless attack.canFire}}disabled{{/unless}}>Attack</button><button type="button" data-action="reloadWeapon" data-item-id="{{id}}" {{#unless attack.requiresAmmo}}disabled{{/unless}}>Reload (refill)</button></div>
{{#unless attack.supported}}<p class="hud-overcap">Special firing mode: manual resolution required.</p>{{/unless}}
</div>{{else}}<p class="hud-help">Equip a weapon in Inventory to use it here.</p>{{/each}}</section>
<section class="hud-panel hud-damage-application"><h3>APPLY PHYSICAL DAMAGE</h3>
<p class="hud-help">Target exactly one Terran token. A successful attack with a manually entered target Defense fills these fields automatically from its weapon damage and recognized Penetration/Rending traits. Review before applying. Applies energy shields, shield armor, penetration, Damage Resistance and protection before subtracting HP. Special attack traits are not yet handled.</p>
<div class="hud-damage-fields"><label>Damage<input type="number" min="0" step="1" data-damage-field="damage" value="{{damageDraft.damage}}"/></label>
<label>Penetration<input type="number" min="0" step="1" data-damage-field="penetration" value="{{damageDraft.penetration}}"/></label>
<label>Rending<input type="number" min="0" step="1" data-damage-field="rending" value="{{damageDraft.rending}}"/></label>
<button type="button" data-action="applyPhysicalDamage">Review &amp; Apply</button></div>
<p class="hud-help">Crippling wound counts are recorded as pending; their locations, immediate effects and penalties require GM adjudication.</p>
</section>
{{else if (eq tab "inventory")}}
<section class="hud-panel"><h3>EQUIPMENT LOADOUT</h3>
<p class="hud-help">Click an item to inspect its statistics. Right-click an item for Edit and Delete. Save closes its editor. Equipped armor updates Defense and Damage Resistance.</p>
<div class="hud-equipment-actions"><button type="button" data-action="createEquipment" data-item-type="weapon">+ Weapon</button><button type="button" data-action="createEquipment" data-item-type="armor">+ Armor</button><button type="button" data-action="createEquipment" data-item-type="gear">+ Gear</button></div>
{{#each inventory}}
<div class="hud-equipment-card" data-equipment-id="{{id}}">
<div class="hud-equipment-heading">
<button type="button" class="hud-item-image" data-action="chooseItemImage" data-item-id="{{id}}" title="Choose item picture"><img src="{{img}}" alt="Image for {{name}}"/></button><label class="hud-equip-toggle" title="Equipped"><input type="checkbox" data-action="toggleEquipped" data-item-id="{{id}}" {{#if equipped}}checked{{/if}}/></label>
<button type="button" class="hud-equipment-title" data-action="toggleEquipmentDetails" data-item-id="{{id}}" aria-expanded="{{expanded}}"><span class="hud-chevron">{{#if expanded}}▾{{else}}▸{{/if}}</span> {{name}}</button>
<small>{{type}}</small>
<label class="hud-item-quantity" title="Quantity"><span>Qty.</span><input type="number" min="0" step="1" value="{{quantity}}" data-quantity-item-id="{{id}}"/></label>
{{#if editing}}<button type="button" class="hud-equipment-primary-save" data-action="saveEquipment">Save</button><button type="button" data-action="removeEquipment" data-item-id="{{id}}">Delete</button>{{/if}}
<div class="hud-menu-anchor"><button type="button" class="hud-equipment-more" data-action="toggleEquipmentMenu" data-item-id="{{id}}" aria-label="Item options" aria-expanded="{{menuOpen}}">⋯</button>{{#if menuOpen}}<div class="hud-equipment-menu" role="group" aria-label="Item actions">{{#unless editing}}<button type="button" data-action="editEquipment" data-item-id="{{id}}">Edit</button>{{/unless}}<button type="button" data-action="removeEquipment" data-item-id="{{id}}">Delete</button></div>{{/if}}</div>
</div>
{{#if expanded}}
{{#if editing}}<label class="hud-equipment-name">Item Name<input data-item-name type="text" value="{{name}}" placeholder="Name this item"/></label>{{/if}}
<fieldset class="hud-equipment-fields" {{#unless editing}}disabled{{/unless}}>

<label>Weight (lb.)<input data-item-field="weight" type="number" min="0" step="any" value="{{weight}}"/></label>
<label>Cost (credits)<input data-item-field="cost" type="number" min="0" value="{{cost}}"/></label>
<label>Tier<input data-item-field="tier" type="number" min="1" value="{{tier}}"/></label>
{{#if (eq type "weapon")}}
<label>Weapon Class<input data-item-field="weaponClass" value="{{weaponClass}}" placeholder="Rifle, Pistol, Melee..."/></label>
<label>Hands<input data-item-field="hands" type="number" min="1" value="{{hands}}"/></label>
<label>Base Damage<input data-item-field="damage" type="number" value="{{damage}}"/></label>
<label>Accuracy Mod.<input data-item-field="accuracy" type="number" value="{{accuracy}}"/></label>
<label>Rate of Fire<select data-item-field="rateOfFire"><option value="{{rateOfFire}}">{{rateOfFire}}</option><option value="Slow">Slow</option><option value="Average">Average</option><option value="Fast">Fast</option><option value="Automatic">Automatic</option><option value="Full Automatic">Full Automatic</option><option value="Thrown">Thrown</option><option value="Planted">Planted</option></select></label>
<label>Range<select data-item-field="range"><option value="{{range}}">{{range}}</option><option value="Melee">Melee</option><option value="Short">Short</option><option value="Medium">Medium</option><option value="Long">Long</option><option value="Distant">Distant</option><option value="Remote">Remote</option><option value="Thrown">Thrown</option></select></label>
<label>Magazine Capacity<input data-item-field="shots" type="number" min="0" value="{{shots}}"/></label>
<label>Ammo Remaining<input data-item-field="currentShots" type="number" min="0" value="{{currentShots}}"/></label>
<label>Ammunition Type<input data-item-field="ammunition" value="{{ammunition}}"/></label>
<label>Power Rating<input data-item-field="powerRating" type="number" value="{{powerRating}}"/></label>
{{else if (eq type "armor")}}
<label>Armor Type<input data-item-field="armorType" value="{{armorType}}" placeholder="Light, Heavy, Powered..."/></label>
<label>Damage Resistance<input data-item-field="armorResistance" type="number" value="{{armorResistance}}"/></label>
<label>Defense Penalty<input data-item-field="armorDefensePenalty" type="number" value="{{armorDefensePenalty}}"/></label>
<label>Armor Rating<input data-item-field="armorRating" type="number" value="{{armorRating}}"/></label>
{{/if}}
<label class="hud-wide">Special Traits<input data-item-field="specialTraits" value="{{specialTraits}}" placeholder="Comma-separated traits"/></label>
<label class="hud-wide">Notes<input data-item-field="notes" value="{{notes}}"/></label>
</fieldset>{{/if}}</div>
{{else}}<p class="hud-help">No equipment yet. Create a weapon, armor, or gear item above.</p>{{/each}}</section>
{{else if (eq tab "talents")}}
<section class="hud-panel"><h3>TALENTS & SPECIALIZATIONS</h3><p class="hud-help">Talent and specialization management is planned for a later milestone.</p></section>
{{else if (eq tab "progression")}}
<section class="hud-panel"><h3>CHARACTER PROGRESSION</h3><div class="hud-mods"><label>Level <input type="number" name="system.level" value="{{s.level}}" min="1"/></label><label>Experience <span class="hud-xp-line"><input type="number" name="system.experience" value="{{s.experience}}" min="0"/> <strong>/ {{derived.xpPerLevel}}</strong></span></label><label>Characteristic Points <input type="number" name="system.resources.characteristicPoints" value="{{s.resources.characteristicPoints}}"/></label><label>Banked Points <input type="number" name="system.resources.bankedPoints" value="{{s.resources.bankedPoints}}"/></label></div><p class="hud-help">Experience required per level: {{derived.xpPerLevel}}. This field tracks XP earned toward the next level; level advancement remains manual. Skill points per Terran skill purchase: {{derived.skillPointsPerPurchase}} • Attribute cap: {{derived.attributeMax}} • Skill rank cap: {{derived.skillBaseMax}}</p>
<h3>CHARACTER POWER LEVEL</h3>
<label class="hud-power-select">Power Level <select name="system.powerLevel">{{#each powerLevels}}<option value="{{key}}" {{#if selected}}selected{{/if}}>{{name}}</option>{{/each}}</select></label>
<div class="hud-power-stats"><div>Starting Characteristic Points <b>{{selectedPower.starting}}</b></div><div>Characteristic Points / Level <b>{{selectedPower.perLevel}}</b></div><div>Base Hit Points <b>{{selectedPower.hp}}</b></div></div>
<p class="hud-help">Choose your campaign's power level at character creation. These values are reference statistics; changing power level does not automatically spend or award characteristic points.</p><p class="hud-help">Automatic spending, purchases and specialization progression are not yet enabled.</p></section>
{{else if (eq tab "psionics")}}
<section class="hud-panel"><h3>PSIONIC RECORDS</h3><div class="hud-mods"><label>Psi Level <input type="number" name="system.combat.psiLevel" value="{{s.combat.psiLevel}}"/></label></div><p class="hud-help">Psionic powers and disciplines are planned for a later milestone.</p></section>
{{else if (eq tab "bio")}}
<section class="hud-panel"><h3>PERSONNEL BIOGRAPHY</h3>
<div class="hud-bio-fields"><label>Faction<input name="system.faction" value="{{s.faction}}" placeholder="Faction affiliation"/></label><label>Background<input name="system.background" value="{{s.background}}" placeholder="Character background"/></label><label>Quirk<input name="system.quirk" value="{{s.quirk}}" placeholder="Character quirk"/></label></div>
<label class="hud-bio-story">Backstory &amp; Additional Information<textarea name="system.notes" rows="14" placeholder="Write your character's history, personality, goals, and additional information here...">{{s.notes}}</textarea></label>
</section>
{{/if}}
</div>

{{#if (eq tab "combat")}}<section class="hud-panel sc-wounds"><h3>CRIPPLING WOUNDS</h3><p class="hud-help">Resolve pending wounds after damage. Standard attacks roll one location for all wound points. Immediate effects, ongoing penalties, maiming and death require GM adjudication.</p><button type="button" data-action="resolveWounds">Roll Pending Wound Location</button><div class="hud-npc-grid">{{#each woundRows}}<div class="sc-wound-row"><strong>{{label}}: {{points}}</strong><small>{{immediate}}</small><small>{{ongoing}}</small>{{#if ../isGM}}<input type="number" min="0" value="{{points}}" data-wound-points="{{key}}"/><button type="button" data-action="adjustWound" data-location="{{key}}">GM Set</button>{{/if}}</div>{{/each}}</div><h4>Recent Wound History</h4>{{#each woundHistory}}<p class="hud-help">{{location}}: {{points}} ({{source}}) {{#if override}}[GM override]{{/if}}</p>{{else}}<p class="hud-help">No recorded wounds.</p>{{/each}}</section>{{/if}}<footer class="hud-footer">ALPHA 3 • Derived statistics, level limits and focuses are calculated. Warning-only caps; advanced automation in development.</footer>
</section>