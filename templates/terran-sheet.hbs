<section class="hud-shell">
<style>
.terran-hud .hud-attribute-strip{display:grid;grid-template-columns:repeat(auto-fit,minmax(150px,1fr));gap:8px}
.terran-hud .hud-attribute-strip .hud-stat{display:flex;flex-wrap:wrap;align-items:center;gap:4px}
.terran-hud .hud-attribute-strip .hud-stat span{flex:1 1 70px}
.terran-hud .hud-attribute-strip .hud-stat input{width:44px;min-width:0}
.terran-hud .skill-grid{display:grid;grid-template-columns:minmax(0,1.7fr) minmax(0,1fr);gap:12px;align-items:start}
.terran-hud .hud-wounds-below-resources .hud-npc-grid{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:8px}
.terran-hud .hud-wounds-below-resources .sc-wound-row{display:flex;flex-wrap:wrap;align-items:center;gap:6px}
.terran-hud .hud-wounds-below-resources .sc-wound-row input{width:55px}
.terran-hud .hud-special-actions{display:flex;flex-wrap:wrap;gap:8px}
.terran-hud .hud-identity-simple + .hud-panel .hud-values{display:grid;grid-template-columns:repeat(auto-fit,minmax(130px,1fr));gap:6px}
@media(max-width:750px){.terran-hud .skill-grid{grid-template-columns:1fr}.terran-hud .hud-wounds-below-resources .hud-npc-grid{grid-template-columns:repeat(2,minmax(0,1fr))}}
.terran-hud .hud-identity-telemetry{display:grid;grid-template-columns:100px minmax(0,1fr);gap:14px;align-items:start}
.terran-hud .hud-identity-telemetry img{width:100px;height:100px;object-fit:cover}
.terran-hud .hud-identity-stats{min-width:0}
.terran-hud .hud-identity-stats .hud-values{display:grid;grid-template-columns:repeat(auto-fit,minmax(120px,1fr));gap:6px;margin-top:8px}
.terran-hud .hud-attribute-notices{margin:4px 0 10px}
.terran-hud .sc-wounds .sc-wound-row input{width:70px}
.terran-hud .hud-identity.hud-identity-telemetry{display:grid!important;grid-template-columns:100px minmax(0,1fr)!important;width:100%!important;max-width:none!important}
.terran-hud .hud-identity-telemetry .hud-identity-stats,.terran-hud .hud-identity-telemetry .hud-identity-stats>label,.terran-hud .hud-identity-telemetry .hud-identity-stats input{width:100%!important;max-width:none!important;min-width:0!important;box-sizing:border-box}
.terran-hud .hud-identity-telemetry .hud-values{display:grid!important;grid-template-columns:repeat(auto-fit,minmax(140px,1fr))!important;width:100%!important;max-width:none!important}
.terran-hud .hud-attribute-strip{grid-template-columns:repeat(auto-fit,minmax(125px,1fr))!important;gap:10px}
.terran-hud .hud-attribute-card{border:1px solid #59636c;border-radius:8px;padding:6px;text-align:center;min-width:0}
.terran-hud .hud-attribute-name{font-weight:700;width:100%;cursor:pointer}
.terran-hud .hud-attribute-total{font-size:2rem;font-weight:800;padding:7px 0}
.terran-hud .hud-attribute-substats{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:6px}
.terran-hud .hud-attribute-substats label{display:flex;flex-direction:column;font-size:.75rem}
.terran-hud .hud-attribute-substats input{width:100%;min-width:0;text-align:center;box-sizing:border-box}
.terran-hud .hud-wounds-strip{display:grid;grid-template-columns:auto repeat(6,minmax(0,1fr));background:#edc95e;color:#16130a;border:2px solid #3d3215;align-items:stretch}
.terran-hud .hud-wounds-strip>strong{padding:8px;font-size:.8rem}
.terran-hud .hud-wound-cell{display:flex;align-items:center;justify-content:center;gap:5px;border-left:2px solid #3d3215;padding:4px;font-size:.75rem;font-weight:800;text-transform:uppercase;min-width:0}
.terran-hud .hud-wound-cell input{width:44px!important;min-width:0!important;height:25px;text-align:center;background:#f8e5a5;color:#16130a}
@media(max-width:740px){.terran-hud .hud-wounds-strip{grid-template-columns:repeat(3,minmax(0,1fr))}.terran-hud .hud-wounds-strip>strong{grid-column:1/-1}}
.terran-hud .hud-credits-panel{display:flex;align-items:center;margin-bottom:10px}
.terran-hud .hud-credits-panel label{display:flex;align-items:center;gap:12px;font-weight:700}
.terran-hud .hud-credits-panel input{width:140px}
.terran-hud .hud-inventory-category{margin:12px 0 20px}
.terran-hud .hud-inventory-category>h4{margin:0 0 8px;padding:7px 10px;border-bottom:2px solid var(--color-border-light-primary,#58626b);text-transform:uppercase;letter-spacing:.06em}
.terran-hud .hud-inventory-category .hud-inventory-heading{display:flex;justify-content:space-between;align-items:center;gap:12px;border-bottom:2px solid var(--color-border-light-primary,#58626b);padding:6px 0;margin-bottom:8px}
.terran-hud .hud-inventory-category .hud-inventory-heading h4{margin:0;border:0;padding:0;flex:1}
.terran-hud .hud-inventory-category .hud-inventory-heading button{flex:none;margin-left:auto}
.terran-hud .hud-special-actions{display:grid!important;grid-template-columns:repeat(4,minmax(0,1fr))!important;gap:14px!important;width:100%}
.terran-hud .hud-special-actions button{width:100%;min-width:0;justify-content:center}
@media(max-width:650px){.terran-hud .hud-special-actions{grid-template-columns:repeat(2,minmax(0,1fr))!important}}
.terran-hud .hud-wounds-strip{grid-template-columns:minmax(135px,1.3fr) repeat(6,minmax(0,1fr))!important}
.terran-hud .hud-wounds-label{display:flex;align-items:center;gap:7px;flex-wrap:wrap}
.terran-hud .hud-wound-title{appearance:none;border:0;background:transparent;color:inherit;box-shadow:none;padding:2px 3px;font:inherit;font-weight:800;cursor:pointer;white-space:nowrap}
.terran-hud .hud-wound-title:hover{text-decoration:underline}
.terran-hud .hud-pending-title{border:1px solid #594821;border-radius:4px;padding:4px 6px;background:#f8e5a5}
@media(max-width:740px){.terran-hud .hud-wounds-strip{grid-template-columns:repeat(3,minmax(0,1fr))!important}}
</style>
<header class="hud-header"><span>RAIDERS // PERSONNEL FILE</span><strong>TERRAN INTERFACE • ALPHA</strong></header>
<div class="hud-identity hud-identity-simple hud-identity-telemetry"><img src="{{actor.img}}" alt="Portrait"/><div class="hud-identity-stats"><label>Character Name <input name="name" value="{{actor.name}}" placeholder="Enter character name"/></label><div class="hud-values"><div>Defense <b>{{derived.computed.defense}}</b></div><div>Toughness <b>{{derived.computed.toughness}}</b></div><div>Resolve <b>{{derived.computed.resolve}}</b></div><div>Damage Threshold <b>{{derived.computed.damageThreshold}}</b></div><div>Damage Resistance <b>{{derived.computed.damageResistance}}</b></div><div>Psionic Resistance <b>{{derived.computed.psionicResistance}}</b></div><div>Healing Threshold <b>{{derived.computed.healingThreshold}}</b></div><div>Move <b>{{derived.computed.moveSpeed}}</b></div><div>Shift <b>{{derived.computed.shiftSpeed}}</b></div><div>Initiative <b>{{derived.computed.initiative}}</b></div><div>Morale <b>{{derived.computed.moraleBonus}}</b></div></div></div></div>
<div class="hud-resources"><div>HP <input type="number" name="system.resources.hp.value" value="{{s.resources.hp.value}}"/> / {{derived.computed.hpMax}}</div><div>Shields <input type="number" name="system.resources.shields.value" value="{{s.resources.shields.value}}"/> / <input type="number" name="system.resources.shields.max" value="{{s.resources.shields.max}}"/></div><div>Fatigue <input type="number" name="system.resources.fatigue.value" value="{{s.resources.fatigue.value}}"/> / <input type="number" name="system.resources.fatigue.max" value="{{s.resources.fatigue.max}}"/></div></div>
<div class="hud-wounds-strip"><div class="hud-wounds-label">WOUNDS: <button type="button" data-action="resolveWounds" class="hud-wound-title hud-pending-title" title="Roll pending crippling wounds">Pending {{s.resources.woundsPending}}</button></div>{{#each woundRows}}<label class="hud-wound-cell"><button type="button" class="hud-wound-title" data-action="describeWound" data-location="{{key}}" title="Show {{label}} wound effects">{{label}}:</button><input type="number" min="0" max="100" value="{{points}}" data-wound-points="{{key}}"/></label>{{/each}}<label class="hud-wound-cell"><button type="button" class="hud-wound-title" data-action="describeWound" data-location="bleed" title="Show Bleed effects">Bleed:</button><input type="number" min="0" max="1000" value="{{woundConditions.bleed}}" data-player-bleed/></label></div>
<nav class="hud-tabs" aria-label="Terran character sheet sections">{{#each tabs}}<button type="button" data-action="changeTab" data-tab="{{key}}" class="{{#if active}}active{{/if}}" aria-pressed="{{active}}">{{title}}</button>{{/each}}</nav>
<div class="hud-tab-content" role="region" aria-label="Character tab contents" tabindex="0">
{{#if (eq tab "combat")}}
{{/if}}
{{#if (eq tab "overview")}}
<section class="hud-panel hud-attributes-horizontal"><h3>ATTRIBUTES</h3><div class="hud-attribute-strip">{{#each attributes}}<div class="hud-attribute-card"><button type="button" class="hud-attribute-name" data-action="rollAttribute" data-attribute="{{key}}">{{name}}</button><div class="hud-attribute-total">{{total}}</div><div class="hud-attribute-substats"><label>Base<input type="number" name="system.attributes.{{key}}.base" value="{{base}}"/></label><label>Misc<input type="number" name="system.attributes.{{key}}.misc" value="{{misc}}"/></label></div></div>{{/each}}</div></section>
<div class="hud-attribute-notices"><p class="hud-help">Maximum normal attribute: {{derived.attributeMax}}</p>{{#each derived.warnings}}<p class="hud-overcap">{{this}}</p>{{/each}}</div>
<div class="hud-columns skill-grid"><section class="hud-panel"><h3>NON-PROWESS SKILLS</h3><p class="hud-help">Roll • Skill • Ranks • Focuses • Misc • Total (cap)</p><p class="hud-help">Base rank cap: {{derived.skillBaseMax}}. First focus adds 2, each additional focus adds 1.</p>{{#each skills}}<div class="hud-stat"><button type="button" data-action="rollSkill" data-skill="{{key}}">◈</button><span title="{{attribute}}">{{name}}</span><input type="number" name="system.skills.{{key}}.ranks" value="{{ranks}}" min="0" title="Ranks (maximum {{max}})"/><input type="number" name="system.skills.{{key}}.focus" value="{{focus}}" min="0" title="Number of skill focuses"/><input type="number" name="system.skills.{{key}}.misc" value="{{misc}}"/><b title="Maximum ranks: {{max}}" class="{{#if over}}hud-overcap{{/if}}">{{total}}</b><small>/{{max}}</small></div>{{/each}}</section>
<section class="hud-panel"><h3>PROWESS SKILLS</h3>{{#each prowess}}<div class="hud-stat"><span>{{name}}</span><input type="number" name="system.prowess.{{key}}.ranks" value="{{ranks}}" min="0" title="Maximum ranks: {{max}}"/><input type="number" name="system.prowess.{{key}}.focus" value="{{focus}}" min="0" title="Number of focuses"/><small class="{{#if over}}hud-overcap{{/if}}">/{{max}}</small></div>{{/each}}</section></div>

{{else if (eq tab "combat")}}
<section class="hud-panel"><h3>COMBAT MODIFIERS</h3><div class="hud-mods"><label>Protection Points <input type="number" min="0" name="system.resources.protection" value="{{s.resources.protection}}"/></label><label>Pending Crippling Wounds <input type="number" min="0" name="system.resources.woundsPending" value="{{s.resources.woundsPending}}"/></label></div><div class="hud-mods"><label>Armor DR <input type="number" name="system.combat.armorResistance" value="{{s.combat.armorResistance}}"/></label><label>Armor Defense <input type="number" name="system.combat.armorDefensePenalty" value="{{s.combat.armorDefensePenalty}}"/></label><label>Psi Level <input type="number" name="system.combat.psiLevel" value="{{s.combat.psiLevel}}"/></label><label>Bonus HP <input type="number" name="system.combat.bonusHP" value="{{s.combat.bonusHP}}"/></label></div><p class="hud-help">Equipped armor contributes {{derived.equipment.armorResistance}} armor DR and {{derived.equipment.armorDefensePenalty}} to Defense. Armor DR/Defense fields above are additional manual modifiers. Weapon attacks and wound automation are still planned.</p></section>
<section class="hud-panel"><h3>SPECIAL COMBAT ACTIONS</h3><div class="hud-special-actions"><button type="button" data-action="grabTarget">Grab</button><button type="button" data-action="knockDownTarget">Knock Down</button><button type="button" data-action="pushTarget">Push</button><button type="button" data-action="disarmWeapon">Disarm</button></div></section>
<section class="hud-panel"><h3>EQUIPPED WEAPONS</h3><p class="hud-help">Standard attacks roll 1d20 + Melee/Ranged ranks + weapon accuracy + 4 for each bonus strike. Enter a target Defense to calculate hit, attack overage and pre-resistance damage automatically. Range penalties, firing traits, criticals and reload timing still require GM adjudication.</p>
{{#each combatWeapons}}
<div class="hud-combat-weapon" data-base-accuracy="{{attack.accuracy}}" data-base-damage="{{attack.damage}}" data-melee="{{attack.melee}}"><strong>{{name}}</strong><span>{{range}} • {{rate}}</span><div class="hud-weapon-values"><span>Accuracy <b data-preview-accuracy>{{attack.accuracy}}</b></span><span>Strikes <b>{{attack.strikes}}</b></span><span>Pre-resistance Damage <b data-preview-damage>{{attack.damage}}</b></span><span>Overage Cap <b>{{attack.overageCap}}</b></span>{{#if attack.requiresAmmo}}<span>Ammo <b>{{attack.ammo}} / {{attack.capacity}}</b></span>{{/if}}</div>
<label class="hud-help">Charge (full-round; +5 accuracy, melee +10 damage) <input type="checkbox" data-charge/></label><label class="hud-help">Action Move (full-round, −2 accuracy) <input type="checkbox" data-action-move/></label><label class="hud-target-defense">Target Defense <input type="number" min="0" step="1" data-target-defense placeholder="Optional"/></label><div class="hud-weapon-actions"><button type="button" data-action="attackWeapon" data-item-id="{{id}}" {{#unless attack.canFire}}disabled{{/unless}}>Attack</button>{{#if attack.requiresAmmo}}<button type="button" data-action="reloadWeapon" data-item-id="{{id}}">Reload (refill)</button>{{/if}}</div>
{{#unless attack.supported}}<p class="hud-overcap">Special firing mode: manual resolution required.</p>{{/unless}}
</div>{{else}}<p class="hud-help">Equip a weapon in Inventory to use it here.</p>{{/each}}</section>
{{else if (eq tab "inventory")}}
<section class="hud-panel hud-credits-panel"><label><strong>Credits</strong> <input type="number" min="0" step="1" name="system.resources.credits" value="{{s.resources.credits}}" aria-label="Character credits"/></label></section>
<section class="hud-panel hud-inventory-sections">
<section class="hud-inventory-category"><div class="hud-inventory-heading"><h4>Weapons</h4><button type="button" data-action="createEquipment" data-item-type="weapon">+ Weapon</button></div>{{#each inventoryWeapons}}
<div class="hud-equipment-card" data-equipment-id="{{id}}">
<div class="hud-equipment-heading">
<button type="button" class="hud-item-image" data-action="chooseItemImage" data-item-id="{{id}}" title="Choose item picture"><img src="{{img}}" alt="Image for {{name}}"/></button><label class="hud-equip-toggle" title="Equipped"><input type="checkbox" data-action="toggleEquipped" data-item-id="{{id}}" {{#if equipped}}checked{{/if}}/></label>
<button type="button" class="hud-equipment-title" data-action="toggleEquipmentDetails" data-item-id="{{id}}" aria-expanded="{{expanded}}"><span class="hud-chevron">{{#if expanded}}▾{{else}}▸{{/if}}</span> {{name}}</button>
<label class="hud-item-quantity" title="Quantity"><span>Qty.</span><input type="number" min="0" step="1" value="{{quantity}}" data-quantity-item-id="{{id}}"/></label>
{{#if editing}}<button type="button" class="hud-equipment-primary-save" data-action="saveEquipment">Save</button><button type="button" data-action="removeEquipment" data-item-id="{{id}}">Delete</button>{{/if}}
<div class="hud-menu-anchor"><button type="button" class="hud-equipment-more" data-action="toggleEquipmentMenu" data-item-id="{{id}}" aria-label="Item options" aria-expanded="{{menuOpen}}">⋯</button>{{#if menuOpen}}<div class="hud-equipment-menu" role="group" aria-label="Item actions">{{#unless editing}}<button type="button" data-action="editEquipment" data-item-id="{{id}}">Edit</button>{{/unless}}<button type="button" data-action="removeEquipment" data-item-id="{{id}}">Delete</button></div>{{/if}}</div>
</div>
{{#if expanded}}
{{#if editing}}<label class="hud-equipment-name">Item Name<input data-item-name type="text" value="{{name}}" placeholder="Name this item"/></label>{{/if}}
<fieldset class="hud-equipment-fields" {{#unless editing}}disabled{{/unless}}>

<label>Weight (lb.)<input data-item-field="weight" type="number" min="0" step="any" value="{{weight}}"/></label>
<label>Cost (credits)<input data-item-field="cost" type="number" min="0" value="{{cost}}"/></label>
<label>Tier<input data-item-field="tier" type="number" min="1" value="{{tier}}"/></label>
{{#if (eq type "weapon")}}
<label>Weapon Class<select data-item-field="weaponClass"><option value="{{weaponClass}}">{{weaponClass}}</option><option value="Pistol">Pistol</option><option value="Rifle">Rifle</option><option value="Heavy Weapon">Heavy Weapon</option><option value="Explosive">Explosive</option><option value="Melee">Melee</option></select></label>
<label>Hands<input data-item-field="hands" type="number" min="1" value="{{hands}}"/></label>
<label>Base Damage<input data-item-field="damage" type="number" value="{{damage}}"/></label>
<label>Accuracy Mod.<input data-item-field="accuracy" type="number" value="{{accuracy}}"/></label>
<label>Rate of Fire<select data-item-field="rateOfFire"><option value="{{rateOfFire}}">{{rateOfFire}}</option><option value="Slow">Slow</option><option value="Average">Average</option><option value="Fast">Fast</option><option value="Automatic">Automatic</option><option value="Full Automatic">Full Automatic</option><option value="Thrown">Thrown</option><option value="Planted">Planted</option></select></label>
<label>Range<select data-item-field="range"><option value="{{range}}">{{range}}</option><option value="Melee">Melee Reach</option><option value="Short">Short — 6 squares</option><option value="Medium">Medium — 30 squares</option><option value="Long">Long — 60 squares</option><option value="Distant">Distant — 120 squares</option><option value="Remote">Remote — 300 squares</option></select></label>
<label>Magazine Capacity<input data-item-field="shots" type="number" min="0" value="{{shots}}"/></label>
<label>Ammo Remaining<input data-item-field="currentShots" type="number" min="0" value="{{currentShots}}"/></label>
<label>Ammunition Type<input data-item-field="ammunition" value="{{ammunition}}"/></label>
<label>Power Rating<input data-item-field="powerRating" type="number" value="{{powerRating}}"/></label>
{{else if (eq type "armor")}}
<label>Armor Type<input data-item-field="armorType" value="{{armorType}}" placeholder="Light, Heavy, Powered..."/></label>
<label>Damage Resistance<input data-item-field="armorResistance" type="number" value="{{armorResistance}}"/></label>
<label>Defense Penalty<input data-item-field="armorDefensePenalty" type="number" value="{{armorDefensePenalty}}"/></label>
<label>Armor Rating<input data-item-field="armorRating" type="number" value="{{armorRating}}"/></label>
{{/if}}
<label class="hud-wide">Special Traits<input data-item-field="specialTraits" value="{{specialTraits}}" placeholder="Comma-separated traits"/></label>
<label class="hud-wide">Notes<input data-item-field="notes" value="{{notes}}"/></label>
</fieldset>{{/if}}</div>
{{else}}<p class="hud-help">No weapons yet.</p>{{/each}}</section>
<section class="hud-inventory-category"><div class="hud-inventory-heading"><h4>Armor</h4><button type="button" data-action="createEquipment" data-item-type="armor">+ Armo</button></div>{{#each inventoryArmor}}
<div class="hud-equipment-card" data-equipment-id="{{id}}">
<div class="hud-equipment-heading">
<button type="button" class="hud-item-image" data-action="chooseItemImage" data-item-id="{{id}}" title="Choose item picture"><img src="{{img}}" alt="Image for {{name}}"/></button><label class="hud-equip-toggle" title="Equipped"><input type="checkbox" data-action="toggleEquipped" data-item-id="{{id}}" {{#if equipped}}checked{{/if}}/></label>
<button type="button" class="hud-equipment-title" data-action="toggleEquipmentDetails" data-item-id="{{id}}" aria-expanded="{{expanded}}"><span class="hud-chevron">{{#if expanded}}▾{{else}}▸{{/if}}</span> {{name}}</button>
<small>{{type}}</small>
<label class="hud-item-quantity" title="Quantity"><span>Qty.</span><input type="number" min="0" step="1" value="{{quantity}}" data-quantity-item-id="{{id}}"/></label>
{{#if editing}}<button type="button" class="hud-equipment-primary-save" data-action="saveEquipment">Save</button><button type="button" data-action="removeEquipment" data-item-id="{{id}}">Delete</button>{{/if}}
<div class="hud-menu-anchor"><button type="button" class="hud-equipment-more" data-action="toggleEquipmentMenu" data-item-id="{{id}}" aria-label="Item options" aria-expanded="{{menuOpen}}">⋯</button>{{#if menuOpen}}<div class="hud-equipment-menu" role="group" aria-label="Item actions">{{#unless editing}}<button type="button" data-action="editEquipment" data-item-id="{{id}}">Edit</button>{{/unless}}<button type="button" data-action="removeEquipment" data-item-id="{{id}}">Delete</button></div>{{/if}}</div>
</div>
{{#if expanded}}
{{#if editing}}<label class="hud-equipment-name">Item Name<input data-item-name type="text" value="{{name}}" placeholder="Name this item"/></label>{{/if}}
<fieldset class="hud-equipment-fields" {{#unless editing}}disabled{{/unless}}>

<label>Weight (lb.)<input data-item-field="weight" type="number" min="0" step="any" value="{{weight}}"/></label>
<label>Cost (credits)<input data-item-field="cost" type="number" min="0" value="{{cost}}"/></label>
<label>Tier<input data-item-field="tier" type="number" min="1" value="{{tier}}"/></label>
{{#if (eq type "weapon")}}
<label>Weapon Class<select data-item-field="weaponClass"><option value="{{weaponClass}}">{{weaponClass}}</option><option value="Pistol">Pistol</option><option value="Rifle">Rifle</option><option value="Heavy Weapon">Heavy Weapon</option><option value="Explosive">Explosive</option><option value="Melee">Melee</option></select></label>
<label>Hands<input data-item-field="hands" type="number" min="1" value="{{hands}}"/></label>
<label>Base Damage<input data-item-field="damage" type="number" value="{{damage}}"/></label>
<label>Accuracy Mod.<input data-item-field="accuracy" type="number" value="{{accuracy}}"/></label>
<label>Rate of Fire<select data-item-field="rateOfFire"><option value="{{rateOfFire}}">{{rateOfFire}}</option><option value="Slow">Slow</option><option value="Average">Average</option><option value="Fast">Fast</option><option value="Automatic">Automatic</option><option value="Full Automatic">Full Automatic</option><option value="Thrown">Thrown</option><option value="Planted">Planted</option></select></label>
<label>Range<select data-item-field="range"><option value="{{range}}">{{range}}</option><option value="Melee">Melee Reach</option><option value="Short">Short — 6 squares</option><option value="Medium">Medium — 30 squares</option><option value="Long">Long — 60 squares</option><option value="Distant">Distant — 120 squares</option><option value="Remote">Remote — 300 squares</option></select></label>
<label>Magazine Capacity<input data-item-field="shots" type="number" min="0" value="{{shots}}"/></label>
<label>Ammo Remaining<input data-item-field="currentShots" type="number" min="0" value="{{currentShots}}"/></label>
<label>Ammunition Type<input data-item-field="ammunition" value="{{ammunition}}"/></label>
<label>Power Rating<input data-item-field="powerRating" type="number" value="{{powerRating}}"/></label>
{{else if (eq type "armor")}}
<label>Armor Type<input data-item-field="armorType" value="{{armorType}}" placeholder="Light, Heavy, Powered..."/></label>
<label>Damage Resistance<input data-item-field="armorResistance" type="number" value="{{armorResistance}}"/></label>
<label>Defense Penalty<input data-item-field="armorDefensePenalty" type="number" value="{{armorDefensePenalty}}"/></label>
<label>Armor Rating<input data-item-field="armorRating" type="number" value="{{armorRating}}"/></label>
{{/if}}
<label class="hud-wide">Special Traits<input data-item-field="specialTraits" value="{{specialTraits}}" placeholder="Comma-separated traits"/></label>
<label class="hud-wide">Notes<input data-item-field="notes" value="{{notes}}"/></label>
</fieldset>{{/if}}</div>
{{else}}<p class="hud-help">No armor yet.</p>{{/each}}</section>
<section class="hud-inventory-category"><div class="hud-inventory-heading"><h4>Gear</h4><button type="button" data-action="createEquipment" data-item-type="gear">+ Gear</button></div>{{#each inventoryGear}}
<div class="hud-equipment-card" data-equipment-id="{{id}}">
<div class="hud-equipment-heading">
<button type="button" class="hud-item-image" data-action="chooseItemImage" data-item-id="{{id}}" title="Choose item picture"><img src="{{img}}" alt="Image for {{name}}"/></button><label class="hud-equip-toggle" title="Equipped"><input type="checkbox" data-action="toggleEquipped" data-item-id="{{id}}" {{#if equipped}}checked{{/if}}/></label>
<button type="button" class="hud-equipment-title" data-action="toggleEquipmentDetails" data-item-id="{{id}}" aria-expanded="{{expanded}}"><span class="hud-chevron">{{#if expanded}}▾{{else}}▸{{/if}}</span> {{name}}</button>
<small>{{type}}</small>
<label class="hud-item-quantity" title="Quantity"><span>Qty.</span><input type="number" min="0" step="1" value="{{quantity}}" data-quantity-item-id="{{id}}"/></label>
{{#if editing}}<button type="button" class="hud-equipment-primary-save" data-action="saveEquipment">Save</button><button type="button" data-action="removeEquipment" data-item-id="{{id}}">Delete</button>{{/if}}
<div class="hud-menu-anchor"><button type="button" class="hud-equipment-more" data-action="toggleEquipmentMenu" data-item-id="{{id}}" aria-label="Item options" aria-expanded="{{menuOpen}}">⋯</button>{{#if menuOpen}}<div class="hud-equipment-menu" role="group" aria-label="Item actions">{{#unless editing}}<button type="button" data-action="editEquipment" data-item-id="{{id}}">Edit</button>{{/unless}}<button type="button" data-action="removeEquipment" data-item-id="{{id}}">Delete</button></div>{{/if}}</div>
</div>
{{#if expanded}}
{{#if editing}}<label class="hud-equipment-name">Item Name<input data-item-name type="text" value="{{name}}" placeholder="Name this item"/></label>{{/if}}
<fieldset class="hud-equipment-fields" {{#unless editing}}disabled{{/unless}}>

<label>Weight (lb.)<input data-item-field="weight" type="number" min="0" step="any" value="{{weight}}"/></label>
<label>Cost (credits)<input data-item-field="cost" type="number" min="0" value="{{cost}}"/></label>
<label>Tier<input data-item-field="tier" type="number" min="1" value="{{tier}}"/></label>
{{#if (eq type "weapon")}}
<label>Weapon Class<select data-item-field="weaponClass"><option value="{{weaponClass}}">{{weaponClass}}</option><option value="Pistol">Pistol</option><option value="Rifle">Rifle</option><option value="Heavy Weapon">Heavy Weapon</option><option value="Explosive">Explosive</option><option value="Melee">Melee</option></select></label>
<label>Hands<input data-item-field="hands" type="number" min="1" value="{{hands}}"/></label>
<label>Base Damage<input data-item-field="damage" type="number" value="{{damage}}"/></label>
<label>Accuracy Mod.<input data-item-field="accuracy" type="number" value="{{accuracy}}"/></label>
<label>Rate of Fire<select data-item-field="rateOfFire"><option value="{{rateOfFire}}">{{rateOfFire}}</option><option value="Slow">Slow</option><option value="Average">Average</option><option value="Fast">Fast</option><option value="Automatic">Automatic</option><option value="Full Automatic">Full Automatic</option><option value="Thrown">Thrown</option><option value="Planted">Planted</option></select></label>
<label>Range<select data-item-field="range"><option value="{{range}}">{{range}}</option><option value="Melee">Melee Reach</option><option value="Short">Short — 6 squares</option><option value="Medium">Medium — 30 squares</option><option value="Long">Long — 60 squares</option><option value="Distant">Distant — 120 squares</option><option value="Remote">Remote — 300 squares</option></select></label>
<label>Magazine Capacity<input data-item-field="shots" type="number" min="0" value="{{shots}}"/></label>
<label>Ammo Remaining<input data-item-field="currentShots" type="number" min="0" value="{{currentShots}}"/></label>
<label>Ammunition Type<input data-item-field="ammunition" value="{{ammunition}}"/></label>
<label>Power Rating<input data-item-field="powerRating" type="number" value="{{powerRating}}"/></label>
{{else if (eq type "armor")}}
<label>Armor Type<input data-item-field="armorType" value="{{armorType}}" placeholder="Light, Heavy, Powered..."/></label>
<label>Damage Resistance<input data-item-field="armorResistance" type="number" value="{{armorResistance}}"/></label>
<label>Defense Penalty<input data-item-field="armorDefensePenalty" type="number" value="{{armorDefensePenalty}}"/></label>
<label>Armor Rating<input data-item-field="armorRating" type="number" value="{{armorRating}}"/></label>
{{/if}}
<label class="hud-wide">Special Traits<input data-item-field="specialTraits" value="{{specialTraits}}" placeholder="Comma-separated traits"/></label>
<label class="hud-wide">Notes<input data-item-field="notes" value="{{notes}}"/></label>
</fieldset>{{/if}}</div>
{{else}}<p class="hud-help">No gear yet.</p>{{/each}}</section></section>
{{else if (eq tab "talents")}}
<section class="hud-panel"><h3>TALENTS & SPECIALIZATIONS</h3><p class="hud-help">Talent and specialization management is planned for a later milestone.</p></section>
{{else if (eq tab "progression")}}
<section class="hud-panel"><h3>CHARACTER PROGRESSION</h3><div class="hud-mods"><label>Level <input type="number" name="system.level" value="{{s.level}}" min="1"/></label><label>Experience <span class="hud-xp-line"><input type="number" name="system.experience" value="{{s.experience}}" min="0"/> <strong>/ {{derived.xpPerLevel}}</strong></span></label><label>Characteristic Points <input type="number" name="system.resources.characteristicPoints" value="{{s.resources.characteristicPoints}}"/></label><label>Banked Points <input type="number" name="system.resources.bankedPoints" value="{{s.resources.bankedPoints}}"/></label></div><p class="hud-help">Experience required per level: {{derived.xpPerLevel}}. This field tracks XP earned toward the next level; level advancement remains manual. Skill points per Terran skill purchase: {{derived.skillPointsPerPurchase}} • Attribute cap: {{derived.attributeMax}} • Skill rank cap: {{derived.skillBaseMax}}</p>
<h3>CHARACTER POWER LEVEL</h3>
<label class="hud-power-select">Power Level <select name="system.powerLevel">{{#each powerLevels}}<option value="{{key}}" {{#if selected}}selected{{/if}}>{{name}}</option>{{/each}}</select></label>
<div class="hud-power-stats"><div>Starting Characteristic Points <b>{{selectedPower.starting}}</b></div><div>Characteristic Points / Level <b>{{selectedPower.perLevel}}</b></div><div>Base Hit Points <b>{{selectedPower.hp}}</b></div></div>
<p class="hud-help">Choose your campaign's power level at character creation. These values are reference statistics; changing power level does not automatically spend or award characteristic points.</p><p class="hud-help">Automatic spending, purchases and specialization progression are not yet enabled.</p></section>
{{else if (eq tab "psionics")}}
<section class="hud-panel"><h3>PSIONIC RECORDS</h3><div class="hud-mods"><label>Psi Level <input type="number" name="system.combat.psiLevel" value="{{s.combat.psiLevel}}"/></label></div><p class="hud-help">Psionic powers and disciplines are planned for a later milestone.</p></section>
{{else if (eq tab "bio")}}
<section class="hud-panel"><h3>PERSONNEL BIOGRAPHY</h3>
<div class="hud-bio-fields"><label>Faction<input name="system.faction" value="{{s.faction}}" placeholder="Faction affiliation"/></label><label>Background<input name="system.background" value="{{s.background}}" placeholder="Character background"/></label><label>Quirk<input name="system.quirk" value="{{s.quirk}}" placeholder="Character quirk"/></label></div>
<label class="hud-bio-story">Backstory &amp; Additional Information<textarea name="system.notes" rows="14" placeholder="Write your character's history, personality, goals, and additional information here...">{{s.notes}}</textarea></label>
</section>
<section class="hud-panel sc-permanent-injuries"><h3>PERMANENT INJURY RECORD</h3><p class="hud-help">Mobility/Action wound points above 4 create permanent injury records. Core/Vital/Critical at 5+ marks the actor deceased. The GM determines anatomy and narrative consequences. These records persist when wound points are healed.</p><p><strong>Status: {{#if permanentWounds.deceased}}DECEASED{{else}}Alive / not marked deceased{{/if}}</strong></p><label class="hud-bio-story"><strong>Recorded Maiming Injuries</strong><textarea rows="5" data-injury-notes placeholder="Describe permanent injuries, lost limbs, scars, and other lasting effects...">{{permanentInjuryNotes}}</textarea></label><h4>System-Recorded Injuries</h4>{{#each permanentWounds.injuries}}<div class="sc-wound-row"><strong>{{location}} injury</strong>{{#if ../isGM}}<input type="text" maxlength="500" value="{{description}}" data-permanent-injury="{{id}}"/><button type="button" data-action="editPermanentInjury" data-injury-id="{{id}}">Save Description</button><button type="button" data-action="removePermanentInjury" data-injury-id="{{id}}">Remove Injury</button>{{else}}<p>{{description}}</p>{{/if}}</div>{{else}}<p class="hud-help">No permanent injuries recorded.</p>{{/each}}</section>
{{/if}}
</div>

<footer class="hud-footer">ALPHA 3 • Derived statistics, level limits and focuses are calculated. Warning-only caps; advanced automation in development.</footer>
</section>