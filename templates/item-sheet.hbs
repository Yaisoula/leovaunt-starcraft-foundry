.sc-item-editor .hud-race-name input{font-size:24px;min-height:40px;width:100%}
.sc-item-editor .hud-race-description{padding:0 0 10px}
.sc-item-editor .hud-race-section-heading{display:flex;align-items:center;justify-content:space-between;gap:12px;background:#0b171d;border-left:4px solid #d5a049;padding:6px 10px;margin:0 0 10px}
.sc-item-editor .hud-race-section-heading h3{margin:0;padding:0;background:none;border:0;flex:1}
.sc-item-editor .hud-race-section-heading button,.sc-item-editor .hud-race-feature-actions button{width:auto!important;min-width:65px;max-width:none;padding:5px 12px;flex:none}
.sc-item-editor .hud-race-description>.hud-race-prose{padding:0 10px}
.sc-item-editor .hud-race-grid input,.sc-item-editor .hud-race-grid select{height:30px!important;min-height:30px!important;box-sizing:border-box}
.sc-item-editor .hud-race-feature-top{display:flex;align-items:flex-start;justify-content:space-between;gap:12px;min-height:34px}
.sc-item-editor .hud-race-feature-top>strong,.sc-item-editor .hud-race-feature-top>label{flex:1;min-width:0}
.sc-item-editor .hud-race-feature-actions{display:flex;gap:6px;flex:none;margin-left:auto}
.sc-item-editor .hud-race-feature .hud-race-prose{margin-top:6px}

.sc-item-editor .hud-race-identity{align-items:center!important;gap:12px!important;padding:8px 12px!important}
.sc-item-editor .hud-race-identity>button{display:block!important;align-self:center!important;flex:0 0 40px!important;width:40px!important;height:40px!important;min-width:40px!important;min-height:40px!important;aspect-ratio:1/1!important;padding:0!important}
.sc-item-editor .hud-race-identity>.hud-race-name{min-height:40px!important}
.sc-item-editor .hud-race-identity>.hud-race-name input{height:40px!important;min-height:40px!important}
.sc-item-editor .hud-race-identity>.hud-race-name strong{min-height:40px!important}
.sc-item-editor .hud-item-fields{border:0;margin:0;padding:0;min-width:0}
.sc-item-editor .hud-item-fields:disabled{opacity:1}
