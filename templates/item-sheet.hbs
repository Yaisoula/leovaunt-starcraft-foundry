.sc-item-editor .hud-race-description>.hud-race-section-heading:has(> :empty){display:none}
.sc-item-editor .hud-race-description>.hud-race-section-heading{min-height:0}

.sc-item-sheet .hud-race-description{display:block!important;width:100%!important;min-width:0!important}
.sc-item-sheet .hud-race-description .hud-race-section-heading{display:flex!important;justify-content:flex-end!important;width:100%!important;box-sizing:border-box!important}
.sc-item-sheet .hud-race-description .hud-race-section-heading:empty{display:none!important}
.sc-item-sheet .hud-race-description textarea[data-race-description]{display:block!important;width:100%!important;max-width:100%!important;min-width:0!important;box-sizing:border-box!important;resize:vertical}
.sc-item-sheet .hud-race-description .hud-race-section-heading button{margin-left:auto!important}
.sc-item-sheet .hud-item-fields .hud-npc-grid select{height:30px!important;min-height:30px!important;max-height:30px!important;box-sizing:border-box!important;padding-top:0!important;padding-bottom:0!important}
.sc-item-sheet .hud-item-fields .hud-npc-grid input{height:30px!important;min-height:30px!important;box-sizing:border-box!important}
.sc-item-sheet .hud-item-fields .hud-npc-grid+label{display:block!important;margin-top:10px!important}
.sc-item-sheet .hud-item-fields .hud-npc-grid+label textarea{display:block!important;width:100%!important;box-sizing:border-box!important;margin-top:5px!important}

.sc-item-editor prose-mirror,.terran-hud prose-mirror{display:block;width:100%;min-width:0;min-height:140px;box-sizing:border-box}
.sc-item-editor prose-mirror .prosemirror,.terran-hud prose-mirror .prosemirror{min-height:120px}

/* Journal-style formatting controls stay inside the text field, below section headings. */
.sc-richtext-box{display:block;width:100%;min-width:0;box-sizing:border-box;margin-top:6px}
.sc-richtext-box prose-mirror{display:block;width:100%;min-width:0;min-height:150px;box-sizing:border-box}
.sc-richtext-box prose-mirror .prosemirror{min-height:125px}
.sc-richtext-box .prosemirror-menu{position:relative;max-width:100%;flex-wrap:wrap}
.sc-richtext-box [contenteditable="true"]{min-height:110px;overflow-wrap:anywhere}

.sc-format-toolbar{display:flex;flex-wrap:wrap;gap:4px;padding:6px;border:1px solid var(--color-border-light-primary,#777);border-bottom:0;border-radius:4px 4px 0 0}
.sc-format-toolbar button{flex:0 0 auto;min-width:28px;width:auto;padding:3px 8px;cursor:pointer}
.sc-richtext-box{display:block;width:100%;min-width:0}
.sc-richtext-box textarea{display:block;width:100%;min-height:130px;box-sizing:border-box;resize:vertical}
</style></section>