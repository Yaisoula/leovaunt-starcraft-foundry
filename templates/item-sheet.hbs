<section class="hud-shell sc-item-editor"><header class="hud-header"><span>STARCRAFT // {{#if isRace}}RACE{{else}}{{itemTypeLabel}}{{/if}}</span><button type="button" data-action="toggleRaceEditor" class="hud-race-editor-toggle">{{#if raceEditor}}Editor: ON{{else}}Editor: OFF{{/if}}</button></header>
<div class="hud-race-identity"><button type="button" data-action="chooseImage" title="Choose item image"><img src="{{item.img}}" alt="Item image"/></button><div class="hud-race-name">{{#if raceEditor}}<input name="name" value="{{item.name}}" aria-label="Item name"/>{{else}}<strong>{{item.name}}</strong>{{/if}}</div></div>
<div class="hud-tab-content">


{{#if isRace}}
<nav class="hud-race-tabs"><button type="button" data-action="changeRaceTab" data-race-tab="description" class="{{#if raceTabDescription}}active{{/if}}">Description</button><button type="button" data-action="changeRaceTab" data-race-tab="creation" class="{{#unless raceTabDescription}}active{{/unless}}">Character Creation</button></nav>
{{#if raceTabDescription}}
<div class="hud-race-description">{{#if raceEditor}}<div class="hud-race-section-heading">{{#if descriptionEditing}}<button type="button" data-action="saveRaceDescription">Save</button>{{else}}<button type="button" data-action="editRaceDescription">Edit</button>{{/if}}</div>{{/if}}
{{#if descriptionEditing}}<div class="sc-richtext-box"><div class="sc-format-toolbar" role="toolbar" aria-label="Text formatting"><button type="button" data-format="bold" title="Bold"><b>B</b></button><button type="button" data-format="italic" title="Italic"><i>I</i></button><button type="button" data-format="heading" title="Heading">H</button><button type="button" data-format="bullet" title="Bullet list">• List</button><button type="button" data-format="number" title="Numbered list">1. List</button><button type="button" data-format="link" title="Link">Link</button></div><textarea name="system.description" data-race-description rows="8">{{s.description}}</textarea></div>{{else}}<div class="hud-race-prose">{{{s.description}}}</div>{{/if}}</div>
{{else}}
<section class="hud-panel"><h3>CHARACTER CREATION</h3><div class="hud-race-grid"><label>Characteristic Point Cost{{#if raceEditor}}<input data-race-field type="number" name="system.cost" value="{{s.cost}}"/>{{else}}<strong class="hud-race-readonly">{{s.cost}}</strong>{{/if}}</label><label>Strength{{#if raceEditor}}<input data-race-field type="number" name="system.raceAttributes.strength" value="{{s.raceAttributes.strength}}"/>{{else}}<strong class="hud-race-readonly">{{s.raceAttributes.strength}}</strong>{{/if}}</label><label>Agility{{#if raceEditor}}<input data-race-field type="number" name="system.raceAttributes.agility" value="{{s.raceAttributes.agility}}"/>{{else}}<strong class="hud-race-readonly">{{s.raceAttributes.agility}}</strong>{{/if}}</label><label>Intelligence{{#if raceEditor}}<input data-race-field type="number" name="system.raceAttributes.intelligence" value="{{s.raceAttributes.intelligence}}"/>{{else}}<strong class="hud-race-readonly">{{s.raceAttributes.intelligence}}</strong>{{/if}}</label><label>Instinct{{#if raceEditor}}<input data-race-field type="number" name="system.raceAttributes.instinct" value="{{s.raceAttributes.instinct}}"/>{{else}}<strong class="hud-race-readonly">{{s.raceAttributes.instinct}}</strong>{{/if}}</label><label>Fortitude{{#if raceEditor}}<input data-race-field type="number" name="system.raceAttributes.fortitude" value="{{s.raceAttributes.fortitude}}"/>{{else}}<strong class="hud-race-readonly">{{s.raceAttributes.fortitude}}</strong>{{/if}}</label><label>Willpower{{#if raceEditor}}<input data-race-field type="number" name="system.raceAttributes.willpower" value="{{s.raceAttributes.willpower}}"/>{{else}}<strong class="hud-race-readonly">{{s.raceAttributes.willpower}}</strong>{{/if}}</label><label>Maximum Psi Level{{#if raceEditor}}<input data-race-field type="number" name="system.raceMaxPsiLevel" value="{{s.raceMaxPsiLevel}}"/>{{else}}<strong class="hud-race-readonly">{{s.raceMaxPsiLevel}}</strong>{{/if}}</label><label>Starting Psi Level{{#if raceEditor}}<input data-race-field type="number" name="system.racePsiLevel" value="{{s.racePsiLevel}}"/>{{else}}<strong class="hud-race-readonly">{{s.racePsiLevel}}</strong>{{/if}}</label><label>Token Size{{#if raceEditor}}<select data-race-field name="system.raceSize"><option value="tiny" {{#if (eq s.raceSize "tiny")}}selected{{/if}}>Tiny</option><option value="small" {{#if (eq s.raceSize "small")}}selected{{/if}}>Small</option><option value="medium" {{#if (eq s.raceSize "medium")}}selected{{/if}}>Medium</option><option value="large" {{#if (eq s.raceSize "large")}}selected{{/if}}>Large</option><option value="huge" {{#if (eq s.raceSize "huge")}}selected{{/if}}>Huge</option><option value="gargantuan" {{#if (eq s.raceSize "gargantuan")}}selected{{/if}}>Gargantuan</option></select>{{else}}<strong class="hud-race-readonly">{{s.raceSize}}</strong>{{/if}}</label></div></section>
<section class="hud-panel hud-race-features"><div class="hud-race-section-heading"><h3>RACIAL FEATURES</h3>{{#if raceEditor}}<button type="button" data-action="addRaceFeature">+</button>{{/if}}</div>
{{#each raceFeatures}}<div class="hud-race-feature" data-feature-row="{{index}}">
<div class="hud-race-feature-top">{{#if editing}}<label>Feature Name<input data-feature-name value="{{name}}"/></label>{{else}}<strong>{{name}}</strong>{{/if}}
{{#if ../raceEditor}}<div class="hud-race-feature-actions">{{#if editing}}<button type="button" data-action="saveRaceFeature" data-feature-index="{{index}}">Save</button>{{else}}<button type="button" data-action="editRaceFeature" data-feature-index="{{index}}">Edit</button>{{/if}}<button type="button" data-action="removeRaceFeature" data-feature-index="{{index}}">Delete</button></div>{{/if}}</div>
{{#if editing}}<label>Description<div class="sc-richtext-box"><div class="sc-format-toolbar" role="toolbar" aria-label="Text formatting"><button type="button" data-format="bold" title="Bold"><b>B</b></button><button type="button" data-format="italic" title="Italic"><i>I</i></button><button type="button" data-format="heading" title="Heading">H</button><button type="button" data-format="bullet" title="Bullet list">• List</button><button type="button" data-format="number" title="Numbered list">1. List</button><button type="button" data-format="link" title="Link">Link</button></div><textarea data-feature-description rows="8">{{description}}</textarea></div></label>{{else}}<div class="hud-race-prose">{{description}}</div>{{/if}}
</div>{{/each}}
</section>
{{/if}}
{{else}}
<nav class="hud-race-tabs"><button type="button" data-action="changeRaceTab" data-race-tab="description" class="{{#if raceTabDescription}}active{{/if}}">Description</button><button type="button" data-action="changeRaceTab" data-race-tab="creation" class="{{#unless raceTabDescription}}active{{/unless}}">{{itemDetailsTab}}</button></nav>
{{#if raceTabDescription}}
<div class="hud-race-description"><div class="hud-race-section-heading">{{#if raceEditor}}{{#if descriptionEditing}}<button type="button" data-action="saveRaceDescription">Save</button>{{else}}<button type="button" data-action="editRaceDescription">Edit</button>{{/if}}{{/if}}</div>
{{#if descriptionEditing}}<div class="sc-richtext-box"><div class="sc-format-toolbar" role="toolbar" aria-label="Text formatting"><button type="button" data-format="bold" title="Bold"><b>B</b></button><button type="button" data-format="italic" title="Italic"><i>I</i></button><button type="button" data-format="heading" title="Heading">H</button><button type="button" data-format="bullet" title="Bullet list">• List</button><button type="button" data-format="number" title="Numbered list">1. List</button><button type="button" data-format="link" title="Link">Link</button></div><textarea name="system.description" data-race-description rows="8">{{s.description}}</textarea></div>{{else}}<div class="hud-race-prose">{{{s.description}}}</div>{{/if}}</div>
{{else}}
<fieldset class="hud-item-fields" {{#unless raceEditor}}disabled{{/unless}}>
{{#if isOrigin}}<section class="hud-panel"><h3>CHARACTER CREATION</h3><label>Characteristic Point Cost<input type="number" min="0" name="system.cost" value="{{s.cost}}"/></label></section>{{/if}}
{{#unless isOrigin}}<section class="hud-panel"><h3>GENERAL</h3><div class="hud-npc-grid"><label>Quantity<input type="number" min="0" name="system.quantity" value="{{s.quantity}}"/></label><label>Weight<input type="number" min="0" name="system.weight" value="{{s.weight}}"/></label><label>Cost<input type="number" min="0" name="system.cost" value="{{s.cost}}"/></label><label>Tier<input type="number" min="1" name="system.tier" value="{{s.tier}}"/></label></div></section>{{/unless}}

{{#if isWeapon}}<section class="hud-panel"><h3>WEAPON STATISTICS</h3><div class="hud-npc-grid">
<label>Weapon Class<select name="system.weaponClass"><option value="{{s.weaponClass}}">{{s.weaponClass}}</option><option value="Pistol">Pistol</option><option value="Rifle">Rifle</option><option value="Heavy Weapon">Heavy Weapon</option><option value="Explosive">Explosive</option><option value="Melee">Melee</option></select></label><label>Hands<input type="number" min="1" name="system.hands" value="{{s.hands}}"/></label>
<label>Damage<input type="number" name="system.damage" value="{{s.damage}}"/></label><label>Accuracy<input type="number" name="system.accuracy" value="{{s.accuracy}}"/></label>
<label>Rate of Fire<select name="system.rateOfFire"><option value="{{s.rateOfFire}}">{{s.rateOfFire}}</option><option value="Slow">Slow</option><option value="Average">Average</option><option value="Fast">Fast</option><option value="Automatic">Automatic</option><option value="Full Automatic">Full Automatic</option></select></label>
<label>Range<select name="system.range"><option value="{{s.range}}">{{s.range}}</option><option value="Melee">Melee Reach</option><option value="Short">Short — 6 squares</option><option value="Medium">Medium — 30 squares</option><option value="Long">Long — 60 squares</option><option value="Distant">Distant — 120 squares</option><option value="Remote">Remote — 300 squares</option></select></label><label>Magazine Capacity<input type="number" min="0" name="system.shots" value="{{s.shots}}"/></label>
<label>Current Shots<input type="number" min="0" name="system.currentShots" value="{{s.currentShots}}"/></label><label>Ammunition<input name="system.ammunition" value="{{s.ammunition}}"/></label><label>Power Rating<input type="number" name="system.powerRating" value="{{s.powerRating}}"/></label>
</div><label>Special Traits{{#if raceEditor}}<div class="sc-richtext-box"><div class="sc-format-toolbar" role="toolbar" aria-label="Text formatting"><button type="button" data-format="bold" title="Bold"><b>B</b></button><button type="button" data-format="italic" title="Italic"><i>I</i></button><button type="button" data-format="heading" title="Heading">H</button><button type="button" data-format="bullet" title="Bullet list">• List</button><button type="button" data-format="number" title="Numbered list">1. List</button><button type="button" data-format="link" title="Link">Link</button></div><textarea name="system.specialTraits" rows="8"></textarea></div>{{else}}<div class="hud-race-prose">{{s.specialTraits}}</div>{{/if}}</label></section>{{/if}}
{{#if isArmor}}<section class="hud-panel"><h3>ARMOR STATISTICS</h3><div class="hud-npc-grid"><label>Armor Type<input name="system.armorType" value="{{s.armorType}}"/></label><label>Armor Rating<input type="number" name="system.armorRating" value="{{s.armorRating}}"/></label><label>Damage Resistance<input type="number" name="system.armorResistance" value="{{s.armorResistance}}"/></label><label>Defense Modifier<input type="number" name="system.armorDefensePenalty" value="{{s.armorDefensePenalty}}"/></label></div><label>Special Traits{{#if raceEditor}}<div class="sc-richtext-box"><div class="sc-format-toolbar" role="toolbar" aria-label="Text formatting"><button type="button" data-format="bold" title="Bold"><b>B</b></button><button type="button" data-format="italic" title="Italic"><i>I</i></button><button type="button" data-format="heading" title="Heading">H</button><button type="button" data-format="bullet" title="Bullet list">• List</button><button type="button" data-format="number" title="Numbered list">1. List</button><button type="button" data-format="link" title="Link">Link</button></div><textarea name="system.specialTraits" rows="8"></textarea></div>{{else}}<div class="hud-race-prose">{{s.specialTraits}}</div>{{/if}}</label></section>{{/if}}
{{#if isGear}}<section class="hud-panel"><h3>GEAR</h3><label>Special Traits{{#if raceEditor}}<div class="sc-richtext-box"><div class="sc-format-toolbar" role="toolbar" aria-label="Text formatting"><button type="button" data-format="bold" title="Bold"><b>B</b></button><button type="button" data-format="italic" title="Italic"><i>I</i></button><button type="button" data-format="heading" title="Heading">H</button><button type="button" data-format="bullet" title="Bullet list">• List</button><button type="button" data-format="number" title="Numbered list">1. List</button><button type="button" data-format="link" title="Link">Link</button></div><textarea name="system.specialTraits" rows="8"></textarea></div>{{else}}<div class="hud-race-prose">{{s.specialTraits}}</div>{{/if}}</label></section>{{/if}}

<section class="hud-panel"><h3>NOTES</h3>{{#if raceEditor}}<div class="sc-richtext-box"><div class="sc-format-toolbar" role="toolbar" aria-label="Text formatting"><button type="button" data-format="bold" title="Bold"><b>B</b></button><button type="button" data-format="italic" title="Italic"><i>I</i></button><button type="button" data-format="heading" title="Heading">H</button><button type="button" data-format="bullet" title="Bullet list">• List</button><button type="button" data-format="number" title="Numbered list">1. List</button><button type="button" data-format="link" title="Link">Link</button></div><textarea name="system.notes" rows="8"></textarea></div>{{else}}<div class="hud-race-prose">{{s.notes}}</div>{{/if}}</section>

</fieldset>
{{/if}}
{{/if}}

</div><style>
.sc-item-editor .hud-race-tabs{display:flex;gap:8px;margin:12px 0}
.sc-item-editor .hud-race-tabs button{flex:1;padding:8px}
.sc-item-editor .hud-race-tabs .active{border-bottom:3px solid #e7b34e}
.sc-item-editor .hud-race-grid{display:grid;grid-template-columns:repeat(4,minmax(0,1fr));gap:10px}
.sc-item-editor .hud-race-grid label{min-width:0}
.sc-item-editor .hud-race-readonly{display:block;padding:7px;border:1px solid #426374;border-radius:4px}
.sc-item-editor .hud-race-prose{white-space:pre-wrap;overflow-wrap:anywhere;margin:8px 0}
.sc-item-editor .hud-race-feature{border-bottom:1px solid #426374;padding:10px 0}
.sc-item-editor .hud-race-editor-toggle{margin-left:auto;width:auto}

.sc-item-editor .hud-header{display:flex;align-items:center;gap:12px;min-height:42px}
.sc-item-editor .hud-race-editor-toggle{margin-left:auto!important;min-width:125px!important;width:125px!important;flex:0 0 125px;white-space:nowrap}
.sc-item-editor .hud-race-identity{display:flex;align-items:stretch;gap:18px;padding:14px 12px;min-height:0}
.sc-item-editor .hud-race-identity>button{align-self:stretch!important;aspect-ratio:1/1!important;height:auto!important;width:72px!important;min-width:72px!important;min-height:72px!important;flex:0 0 72px!important}
.sc-item-editor .hud-race-identity>.hud-race-name{display:flex;align-items:center;min-height:72px}
.sc-item-editor .hud-race-identity>.hud-race-name input{height:72px!important;min-height:72px!important;box-sizing:border-box}
.sc-item-editor .hud-race-identity>.hud-race-name strong{display:flex;align-items:center;min-height:72px;box-sizing:border-box;width:100%;padding:0 8px}
.sc-item-editor .hud-race-identity>button{display:block;flex:0 0 88px;width:88px;height:88px;min-width:88px;min-height:88px;padding:0;overflow:hidden;border-radius:5px}
.sc-item-editor .hud-race-identity>button img{display:block;width:100%;height:100%;object-fit:cover;aspect-ratio:1/1}
.sc-item-editor .hud-race-name{flex:1;min-width:0}
