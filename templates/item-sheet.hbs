<section class="hud-shell sc-item-editor"><header class="hud-header"><span>STARCRAFT // ITEM EDITOR</span><strong>{{item.type}} EDITOR</strong>{{#if isRace}}<button type="button" data-action="toggleRaceEditor" class="hud-race-editor-toggle">{{#if raceEditor}}Editor: ON{{else}}Editor: OFF{{/if}}</button>{{/if}}</header>
<div class="hud-identity hud-identity-simple"><button type="button" data-action="chooseImage" title="Choose item image"><img src="{{item.img}}" alt="Item image"/></button><div><label>Item Name{{#if isRace}}{{#if raceEditor}}<input name="name" value="{{item.name}}"/>{{else}}<strong>{{item.name}}</strong>{{/if}}{{else}}<input name="name" value="{{item.name}}"/>{{/if}}</label><label>Item Type<strong>{{item.type}}</strong></label></div></div>
<div class="hud-tab-content">


{{#unless isOrigin}}<section class="hud-panel"><h3>GENERAL</h3><div class="hud-npc-grid"><label>Quantity<input type="number" min="0" name="system.quantity" value="{{s.quantity}}"/></label><label>Weight<input type="number" min="0" name="system.weight" value="{{s.weight}}"/></label><label>Cost<input type="number" min="0" name="system.cost" value="{{s.cost}}"/></label><label>Tier<input type="number" min="1" name="system.tier" value="{{s.tier}}"/></label></div></section>{{/unless}}
{{#if isRace}}
<nav class="hud-race-tabs"><button type="button" data-action="changeRaceTab" data-race-tab="description" class="{{#if raceTabDescription}}active{{/if}}">Description</button><button type="button" data-action="changeRaceTab" data-race-tab="creation" class="{{#unless raceTabDescription}}active{{/unless}}">Character Creation</button></nav>
{{#if raceTabDescription}}
<section class="hud-panel"><h3>DESCRIPTION {{#if raceEditor}}{{#unless descriptionEditing}}<button type="button" data-action="editRaceDescription">Edit</button>{{/unless}}{{/if}}</h3>
{{#if descriptionEditing}}<textarea data-race-description rows="12">{{s.description}}</textarea><button type="button" data-action="saveRaceDescription">Save Description</button>{{else}}<div class="hud-race-prose">{{{s.description}}}</div>{{/if}}</section>
{{else}}
<section class="hud-panel"><h3>CHARACTER CREATION</h3><div class="hud-race-grid"><label>Characteristic Point Cost{{#if raceEditor}}<input data-race-field type="number" name="system.cost" value="{{s.cost}}"/>{{else}}<strong class="hud-race-readonly">{{s.cost}}</strong>{{/if}}</label>
<label>Intelligence{{#if raceEditor}}<input data-race-field type="number" name="system.raceAttributes.intelligence" value="{{s.raceAttributes.intelligence}}"/>{{else}}<strong class="hud-race-readonly">{{s.raceAttributes.intelligence}}</strong>{{/if}}</label>
<label>Willpower{{#if raceEditor}}<input data-race-field type="number" name="system.raceAttributes.willpower" value="{{s.raceAttributes.willpower}}"/>{{else}}<strong class="hud-race-readonly">{{s.raceAttributes.willpower}}</strong>{{/if}}</label>
<label>Strength{{#if raceEditor}}<input data-race-field type="number" name="system.raceAttributes.strength" value="{{s.raceAttributes.strength}}"/>{{else}}<strong class="hud-race-readonly">{{s.raceAttributes.strength}}</strong>{{/if}}</label>
<label>Instinct{{#if raceEditor}}<input data-race-field type="number" name="system.raceAttributes.instinct" value="{{s.raceAttributes.instinct}}"/>{{else}}<strong class="hud-race-readonly">{{s.raceAttributes.instinct}}</strong>{{/if}}</label>
<label>Psi Level{{#if raceEditor}}<input data-race-field type="number" name="system.racePsiLevel" value="{{s.racePsiLevel}}"/>{{else}}<strong class="hud-race-readonly">{{s.racePsiLevel}}</strong>{{/if}}</label>
<label>Agility{{#if raceEditor}}<input data-race-field type="number" name="system.raceAttributes.agility" value="{{s.raceAttributes.agility}}"/>{{else}}<strong class="hud-race-readonly">{{s.raceAttributes.agility}}</strong>{{/if}}</label>
<label>Fortitude{{#if raceEditor}}<input data-race-field type="number" name="system.raceAttributes.fortitude" value="{{s.raceAttributes.fortitude}}"/>{{else}}<strong class="hud-race-readonly">{{s.raceAttributes.fortitude}}</strong>{{/if}}</label><label>Token Size{{#if raceEditor}}<select data-race-field name="system.raceSize"><option value="tiny" {{#if (eq s.raceSize "tiny")}}selected{{/if}}>Tiny</option><option value="small" {{#if (eq s.raceSize "small")}}selected{{/if}}>Small</option><option value="medium" {{#if (eq s.raceSize "medium")}}selected{{/if}}>Medium</option><option value="large" {{#if (eq s.raceSize "large")}}selected{{/if}}>Large</option><option value="huge" {{#if (eq s.raceSize "huge")}}selected{{/if}}>Huge</option><option value="gargantuan" {{#if (eq s.raceSize "gargantuan")}}selected{{/if}}>Gargantuan</option></select>{{else}}<strong class="hud-race-readonly">{{s.raceSize}}</strong>{{/if}}</label></div></section>
<section class="hud-panel"><h3>RACIAL FEATURES {{#if raceEditor}}<button type="button" data-action="addRaceFeature">+</button>{{/if}}</h3>
{{#each raceFeatures}}<div class="hud-race-feature" data-feature-row="{{index}}">
{{#if editing}}<label>Feature Name<input data-feature-name value="{{name}}"/></label><label>Description<textarea data-feature-description rows="4">{{description}}</textarea></label><button type="button" data-action="saveRaceFeature" data-feature-index="{{index}}">Save</button>
{{else}}<strong>{{name}}</strong><div class="hud-race-prose">{{description}}</div>{{#if ../raceEditor}}<button type="button" data-action="editRaceFeature" data-feature-index="{{index}}">Edit</button><button type="button" data-action="removeRaceFeature" data-feature-index="{{index}}">Delete</button>{{/if}}{{/if}}
</div>{{/each}}
</section>
{{/if}}
{{else}}
{{#if isOrigin}}<section class="hud-panel"><h3>CHARACTER CREATION</h3><label>Characteristic Point Cost<input type="number" min="0" name="system.cost" value="{{s.cost}}"/></label></section>{{/if}}
{{/if}}
{{#if isWeapon}}<section class="hud-panel"><h3>WEAPON STATISTICS</h3><div class="hud-npc-grid">
<label>Weapon Class<select name="system.weaponClass"><option value="{{s.weaponClass}}">{{s.weaponClass}}</option><option value="Pistol">Pistol</option><option value="Rifle">Rifle</option><option value="Heavy Weapon">Heavy Weapon</option><option value="Explosive">Explosive</option><option value="Melee">Melee</option></select></label><label>Hands<input type="number" min="1" name="system.hands" value="{{s.hands}}"/></label>
<label>Damage<input type="number" name="system.damage" value="{{s.damage}}"/></label><label>Accuracy<input type="number" name="system.accuracy" value="{{s.accuracy}}"/></label>
<label>Rate of Fire<select name="system.rateOfFire"><option value="{{s.rateOfFire}}">{{s.rateOfFire}}</option><option value="Slow">Slow</option><option value="Average">Average</option><option value="Fast">Fast</option><option value="Automatic">Automatic</option><option value="Full Automatic">Full Automatic</option></select></label>
<label>Range<select name="system.range"><option value="{{s.range}}">{{s.range}}</option><option value="Melee">Melee Reach</option><option value="Short">Short — 6 squares</option><option value="Medium">Medium — 30 squares</option><option value="Long">Long — 60 squares</option><option value="Distant">Distant — 120 squares</option><option value="Remote">Remote — 300 squares</option></select></label><label>Magazine Capacity<input type="number" min="0" name="system.shots" value="{{s.shots}}"/></label>
<label>Current Shots<input type="number" min="0" name="system.currentShots" value="{{s.currentShots}}"/></label><label>Ammunition<input name="system.ammunition" value="{{s.ammunition}}"/></label><label>Power Rating<input type="number" name="system.powerRating" value="{{s.powerRating}}"/></label>
</div><label>Special Traits<textarea name="system.specialTraits" rows="3">{{s.specialTraits}}</textarea></label></section>{{/if}}
{{#if isArmor}}<section class="hud-panel"><h3>ARMOR STATISTICS</h3><div class="hud-npc-grid"><label>Armor Type<input name="system.armorType" value="{{s.armorType}}"/></label><label>Armor Rating<input type="number" name="system.armorRating" value="{{s.armorRating}}"/></label><label>Damage Resistance<input type="number" name="system.armorResistance" value="{{s.armorResistance}}"/></label><label>Defense Modifier<input type="number" name="system.armorDefensePenalty" value="{{s.armorDefensePenalty}}"/></label></div><label>Special Traits<textarea name="system.specialTraits" rows="3">{{s.specialTraits}}</textarea></label></section>{{/if}}
{{#if isGear}}<section class="hud-panel"><h3>GEAR</h3><label>Special Traits<textarea name="system.specialTraits" rows="3">{{s.specialTraits}}</textarea></label></section>{{/if}}
{{#unless isRace}}<section class="hud-panel"><h3>DESCRIPTION</h3><textarea name="system.description" rows="5">{{s.description}}</textarea></section>{{/unless}}
{{#unless isRace}}<section class="hud-panel"><h3>NOTES</h3><textarea name="system.notes" rows="4">{{s.notes}}</textarea></section>{{/unless}}
{{#unless isRace}}<p class="hud-help">Create items once in Foundry's Items directory, then drag copies onto Terran or NPC actors. Editing a world item does not automatically update existing actor copies.</p>{{/unless}}
</div><style>
.sc-item-editor .hud-race-tabs{display:flex;gap:8px;margin:12px 0}
.sc-item-editor .hud-race-tabs button{flex:1;padding:8px}
.sc-item-editor .hud-race-tabs .active{border-bottom:3px solid #e7b34e}
.sc-item-editor .hud-race-grid{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:10px}
.sc-item-editor .hud-race-grid label{min-width:0}
.sc-item-editor .hud-race-readonly{display:block;padding:7px;border:1px solid #426374;border-radius:4px}
.sc-item-editor .hud-race-prose{white-space:pre-wrap;overflow-wrap:anywhere;margin:8px 0}
.sc-item-editor .hud-race-feature{border-bottom:1px solid #426374;padding:10px 0}
.sc-item-editor .hud-race-editor-toggle{margin-left:auto;width:auto}
</style></section>